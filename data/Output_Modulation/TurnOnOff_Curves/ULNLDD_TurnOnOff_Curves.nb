 RowBox[{
  RowBox[{"raw", "=", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"First", "[", 
        RowBox[{"StringCases", "[", 
         RowBox[{"ff", ",", 
          RowBox[{
           RowBox[{"\"\<ULNLDD\>\"", "~~", 
            RowBox[{"lddtype", ":", 
             RowBox[{"(", 
              
              RowBox[{"\"\<Mini-\>\"", "|", "\"\<MiniSwitch-\>\"", 
               "|", "\"\<JFET-\>\"", "|", "\"\<-\>\""}], ")"}]}], "~~", 
            RowBox[{"output", ":", 
             RowBox[{"Repeated", "[", "WordCharacter", "]"}]}], 
            "~~", "\"\<-TurnOnOff_\>\""}], ":>", 
           RowBox[{"{", 
            RowBox[{
