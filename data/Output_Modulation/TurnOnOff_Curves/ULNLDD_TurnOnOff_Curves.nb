            RowBox[{"#", "/", "senseResistance"}]}], "}"}], "]"}], "&"}], "@", 
        RowBox[{"BinaryReadList", "[", 
         RowBox[{"ff", ",", "\"\<Real32\>\""}], "]"}]}]}], 
      "\[IndentingNewLine]", "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"ff", ",", "files"}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"2b387039-34b3-7241-a3c8-1b41cc475063"],

