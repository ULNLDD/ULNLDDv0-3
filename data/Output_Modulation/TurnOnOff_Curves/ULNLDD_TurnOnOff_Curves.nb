Cell[BoxData[
 RowBox[{
  RowBox[{"SubdivideLogList", "[", 
   RowBox[{"list_", ",", 
    RowBox[{"m_", ":", "4096"}]}], "]"}], ":=", 
  RowBox[{"list", "[", 
   RowBox[{"[", 
    RowBox[{"DeleteDuplicates", "[", 
     RowBox[{"Round", "[", 
      RowBox[{"10", "^", 
       RowBox[{"Subdivide", "[", 
        RowBox[{"0", ",", 
         RowBox[{"Log10", "[", 
          RowBox[{"Length", "[", "list", "]"}], "]"}], ",", 
         RowBox[{"m", "-", "1"}]}], "]"}]}], "]"}], "]"}], "]"}], 
   "]"}]}]], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"4c4ba2e8-55fb-ee47-9068-f90bf6bacffc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"FilterStartTime", "[", 
   RowBox[{"list_", ",", "time_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "startIdx", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"startIdx", "=", 
      RowBox[{"Max", "[", 
       RowBox[{"1", ",", 
        RowBox[{"Ceiling", "@", 
         RowBox[{"SearchOrderedList", "[", 
          RowBox[{"list", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ">=", "time"}], "&"}]}], 
          "]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"list", "[", 
      RowBox[{"[", 
       RowBox[{"startIdx", ";;", 
        RowBox[{"-", "1"}]}], "]"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FilterEndTime", "[", 
   RowBox[{"list_", ",", "time_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "endIdx", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"endIdx", "=", 
      RowBox[{"Min", "[", 
       RowBox[{
        RowBox[{"Length", "[", "list", "]"}], ",", 
        RowBox[{"Floor", "@", 
         RowBox[{"SearchOrderedList", "[", 
          RowBox[{"list", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "<=", "time"}], "&"}]}], 
          "]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"list", "[", 
      RowBox[{"[", 
       RowBox[{"1", ";;", "endIdx"}], "]"}], "]"}]}]}], "\[IndentingNewLine]",
    "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FilterTime", "[", 
   RowBox[{"list_", ",", "timeStart_", ",", "timeEnd_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"startIdx", ",", "endIdx"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"startIdx", "=", 
      RowBox[{"Max", "[", 
       RowBox[{"1", ",", 
        RowBox[{"Ceiling", "@", 
         RowBox[{"SearchOrderedList", "[", 
          RowBox[{"list", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ">=", "timeStart"}], "&"}]}], 
          "]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"endIdx", "=", 
      RowBox[{"Min", "[", 
       RowBox[{
        RowBox[{"Length", "[", "list", "]"}], ",", 
        RowBox[{"Floor", "@", 
         RowBox[{"SearchOrderedList", "[", 
          RowBox[{"list", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ">", "timeEnd"}], "&"}]}], 
          "]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"list", "[", 
      RowBox[{"[", 
       RowBox[{"startIdx", ";;", "endIdx"}], "]"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]}], "Input",
 CellLabel->"In[3]:=",ExpressionUUID->"707c2347-7324-6349-9b1b-9484e8048b18"]
